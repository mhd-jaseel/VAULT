PORT=5000
MONGODB_URI=your_mongodb_connection_uri_here
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here
# Frontend URL for CORS, sitemap, robots.txt (comma-separated for multiple origins)
# Example production: FRONTEND_URL=https://vaultco.online,https://www.vaultco.online,https://vaultco.vercel.app
FRONTEND_URL=http://localhost:5173

# Google Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here

# Environment
NODE_ENV=development # Set to 'production' in your live environment

# Cloudinary Storage Configuration (Required for permanent image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Cookie Configuration (Optional)
# If left blank, these will automatically configure based on NODE_ENV
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
